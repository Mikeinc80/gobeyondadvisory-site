# Copy to terraform.tfvars and fill in values for your own tenant.

location       = "uksouth"
location_short = "uks"

kubernetes_version = "1.31"

owner          = "platform-engineering"
repository_url = "https://github.com/<your-github-user>/azure-aks-production-platform"

admin_group_object_ids       = ["00000000-0000-0000-0000-000000000000"]
ci_principal_ids             = ["00000000-0000-0000-0000-000000000000"]
secret_officer_principal_ids = ["00000000-0000-0000-0000-000000000000"]

# Restrict the API server to the GitHub Actions egress IP and your admin network.
# Leaving this empty leaves the API server open to the Internet.
api_server_authorized_ip_ranges = ["203.0.113.10/32"]

# Public ingress. Narrow to a corporate range or Front Door prefixes if the
# service is not meant to be Internet-facing.
allowed_ingress_source_prefixes = ["0.0.0.0/0"]

# The Key Vault firewall denies by default; list the IPs that need data-plane
# access from outside the VNet (usually just an admin workstation).
keyvault_allowed_ip_rules = ["203.0.113.10/32"]

alert_email_receivers = {
  platform-oncall = "platform-oncall@example.com"
}

# alert_webhook_receivers is intentionally absent from this file: the webhook URL
# is a credential. Supply it at apply time instead, e.g.
#
#   export TF_VAR_alert_webhook_receivers='{"pagerduty":"https://events.pagerduty.com/..."}'
