{
  "name": "gobeyondadvisory-site",
  "private": true,
  "description": "Static site for gobeyondadvisory.com \u2014 hand-authored HTML, deployed on Netlify.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node scripts/check-site.mjs",
    "check:strict": "node scripts/check-site.mjs --strict",
    "sitemap": "node scripts/build-sitemap.mjs",
    "sitemap:check": "node scripts/build-sitemap.mjs --check",
    "test": "node scripts/test-checks.mjs",
    "validate": "npm run check && npm run sitemap:check && npm test",
    "serve": "npx --yes serve@14.2.4 --no-clipboard .",
    "dev": "npx --yes netlify-cli@17.38.1 dev",
    "icons": "node scripts/build-academy-icons.mjs"
  }
}
