# EKORails — environment configuration
#
# Copy to .env for local work. .env is gitignored; .env.example is not, and must never
# contain a real credential.
#
# Everything in this file is process configuration. None of it is settable from the API,
# the user interface, a feature flag or a database row — which is the point of the release
# gates at the bottom.

# ---------------------------------------------------------------------------
# Environment mode
# ---------------------------------------------------------------------------
# DEMO | SANDBOX | CONTROLLED_PILOT | PRODUCTION
#
# Read once at start-up and frozen. An unknown value is REFUSED rather than defaulted to
# something safe-sounding, because a typo that silently becomes DEMO in production is worse
# than a process that will not start.
EKORAILS_ENV_MODE=SANDBOX

EKORAILS_HOST=127.0.0.1
EKORAILS_PORT=8080
EKORAILS_LOG_LEVEL=info

# Where the built web client lives. Normally found by searching upward from the service;
# set this when the two are deployed from different paths.
# EKORAILS_WEB_ROOT=

# Comma-separated addresses of proxies whose X-Forwarded-For header may be believed.
#
# EMPTY BY DEFAULT, and that is the right default. X-Forwarded-For is set by the client
# unless something in front overwrites it, so a rate limiter keyed on it is a rate limiter
# an attacker turns off by varying a header. With this unset, the socket address is used
# and the header is ignored.
#
# Set it ONLY to the addresses of proxies you actually run. Behind an unconfigured proxy
# every request appears to come from one address and the limits bite far too early — which
# fails loudly and is fixed here. Trusting the header fails silently.
# EKORAILS_TRUSTED_PROXIES=10.0.0.4,10.0.0.5

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The service connects as ekorails_app: not a superuser, no BYPASSRLS, no CREATEROLE, and
# no UPDATE or DELETE grant on the audit, ledger, decision or transition tables.
# scripts/provision-roles.sh creates the roles and asserts that posture.
EKORAILS_DB_HOST=127.0.0.1
EKORAILS_DB_PORT=5432
EKORAILS_DB_NAME=ekorails
EKORAILS_DB_USER=ekorails_app
EKORAILS_DB_PASSWORD=change-me-locally-only
EKORAILS_DB_POOL_MAX=10

# A query that has run for fifteen seconds is not going to finish usefully, and holding a
# connection open is how one slow query becomes an outage.
EKORAILS_DB_STATEMENT_TIMEOUT_MS=15000

# Used by migrations only.
EKORAILS_DB_OWNER=ekorails_owner
EKORAILS_DB_OWNER_PASSWORD=change-me-locally-only

# Superuser connection, used ONLY by scripts/provision-roles.sh to create the three roles.
# Set this where `su postgres` is not available — a managed database, a container, or CI.
# The password comes from PGPASSWORD.
# EKORAILS_DB_SUPERUSER=postgres
# EKORAILS_DB_SUPERUSER_DB=postgres

# Used by pg_dump only. FORCE row-level security applies to the table owner too, so a dump
# taken as the owner silently produces a schema with no rows — a backup that appears to
# succeed and restores nothing. This role exists to prevent exactly that.
EKORAILS_DB_BACKUP_PASSWORD=change-me-locally-only

# How often the background worker looks for due jobs.
EKORAILS_WORKER_TICK_MS=30000

# ---------------------------------------------------------------------------
# Cryptography
# ---------------------------------------------------------------------------
# Field encryption (AES-256-GCM) derives its key from this through HKDF.
#
# KNOWN GAP: this is process configuration on the same host as the data, so an attacker
# with the host has both the ciphertext and the key. A managed key store is the control and
# it is not connected. Recorded as gap 2 in docs/12-threat-model.md.
#
# Generate with: openssl rand -base64 48
EKORAILS_MASTER_KEY=generate-your-own-do-not-use-this-value

# ---------------------------------------------------------------------------
# Cookies
# ---------------------------------------------------------------------------
# Session cookies are Secure by default. Set this ONLY for local HTTP development; the
# application refuses it outside DEMO, SANDBOX and TEST.
# EKORAILS_INSECURE_COOKIES=true

# ---------------------------------------------------------------------------
# Release gates
# ---------------------------------------------------------------------------
# Nine gates stand between this software and live money. Each requires named evidence, and
# a gate is met ONLY by the exact string "true" — no truthiness, no "1", no "yes".
#
# In PRODUCTION mode the process REFUSES TO START with any gate unmet. In this build
# assertLiveMoneyPermitted() throws unconditionally regardless of what is set here.
#
# Setting one of these without the evidence behind it is not a configuration change. It is
# a false statement about the state of the business.

# A written approval or admission letter from the regulator.
EKORAILS_GATE_REGULATORY_APPROVAL=false

# Verification of the licence under which each activity in the flow is performed.
EKORAILS_GATE_LICENCE_VERIFIED=false

# Executed agreements with every partner named in the settlement flow.
EKORAILS_GATE_PARTNER_CONTRACTS=false

# An independent security review, with findings closed.
EKORAILS_GATE_SECURITY_REVIEW=false

# A completed privacy impact assessment and cross-border transfer assessment.
EKORAILS_GATE_PRIVACY_REVIEW=false

# Documented and rehearsed operational procedures.
EKORAILS_GATE_OPERATIONAL_CONTROLS=false

# An evidenced restoration test. Backups that have not been restored are not backups.
EKORAILS_GATE_DR_TESTED=false

# Reconciliation signed off over a sustained period.
EKORAILS_GATE_RECONCILIATION_SIGNOFF=false

# A recorded board decision.
EKORAILS_GATE_BOARD_APPROVAL=false
